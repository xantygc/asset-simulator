<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Huawei Energy System Monitor</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f1f5f9;
            padding: 20px;
            min-height: 100vh;
        }
        .container { max-width: 1800px; margin: 0 auto; }

        .header {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            padding: 20px 30px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ENERGY FLOW DIAGRAM */
        .energy-flow {
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .flow-title {
            text-align: center;
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 25px;
            color: #3b82f6;
        }
        .flow-container {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            gap: 30px;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }
        .flow-node {
            background: rgba(59,130,246,0.1);
            border: 2px solid #3b82f6;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            position: relative;
        }
        .flow-node.active {
            background: rgba(34,197,94,0.2);
            border-color: #22c55e;
            box-shadow: 0 0 20px rgba(34,197,94,0.3);
        }
        .flow-node.warning {
            background: rgba(251,191,36,0.2);
            border-color: #fbbf24;
        }
        .flow-node .icon { font-size: 2.5rem; margin-bottom: 8px; }
        .flow-node .label { font-size: 0.9rem; color: #cbd5e1; margin-bottom: 8px; }
        .flow-node .value { font-size: 1.8rem; font-weight: 700; color: #fff; }
        .flow-node .unit { font-size: 1rem; color: #94a3b8; }

        .flow-center {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .flow-arrow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.05);
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        .flow-arrow.export { color: #f97316; }
        .flow-arrow.import { color: #22c55e; }
        .flow-arrow.charging { color: #3b82f6; }
        .flow-arrow .arrow { font-size: 1.2rem; margin: 0 10px; }
        .flow-arrow .power { font-weight: 700; font-size: 1.1rem; }

        .balance-box {
            background: rgba(139,92,246,0.1);
            border: 2px solid #8b5cf6;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }
        .balance-box .label { font-size: 0.85rem; color: #cbd5e1; }
        .balance-box .value { font-size: 1.5rem; font-weight: 700; margin-top: 5px; }
        .balance-box .value.surplus { color: #22c55e; }
        .balance-box .value.deficit { color: #f97316; }

        /* GRID LAYOUT */
        .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 20px; }
        .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px; }

        .card {
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .card-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #3b82f6;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group { margin-bottom: 12px; }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #cbd5e1;
            font-size: 0.85rem;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 8px 12px;
            background: rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 6px;
            color: #f1f5f9;
            font-size: 0.9rem;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
            margin-top: 8px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            color: white;
        }
        .btn-primary:hover { transform: translateY(-2px); }
        .btn-success { background: #22c55e; color: white; }
        .btn-danger { background: #ef4444; color: white; }

        .chart-container {
            position: relative;
            height: 250px;
            margin-top: 15px;
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
            padding: 15px;
        }

        .stats-row {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }
        .stat-mini {
            flex: 1;
            background: rgba(0,0,0,0.3);
            padding: 10px;
            border-radius: 6px;
            text-align: center;
        }
        .stat-mini .label { font-size: 0.75rem; color: #cbd5e1; }
        .stat-mini .value { font-size: 1.1rem; font-weight: 700; color: #3b82f6; }

        .log-panel {
            background: rgba(0,0,0,0.4);
            border-radius: 6px;
            padding: 12px;
            max-height: 250px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
        }
        .log-entry {
            padding: 3px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            color: #94a3b8;
        }
        .log-entry .timestamp { color: #3b82f6; }
        .log-entry .register { color: #22c55e; }

        .alert {
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: 0.85rem;
        }
        .alert-success { background: rgba(34,197,94,0.2); border: 1px solid #22c55e; color: #86efac; }
        .alert-error { background: rgba(239,68,68,0.2); border: 1px solid #ef4444; color: #fca5a5; }

        .time-badge {
            display: inline-block;
            background: rgba(59,130,246,0.2);
            border: 1px solid #3b82f6;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: 600;
            font-family: 'Courier New', monospace;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-badge.running { background: #22c55e; color: white; }
        .status-badge.stopped { background: #64748b; color: white; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>⚡ Huawei Energy System Monitor</h1>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
            <span style="color: #94a3b8; font-size: 0.9rem;">SUN2000 Inverter + LUNA2000 Battery</span>
            <div>
                <span class="time-badge" id="simTime">--:--:--</span>
                <span class="status-badge stopped" id="simStatus">STOPPED</span>
            </div>
        </div>
    </div>

    <!-- ENERGY FLOW DIAGRAM -->
    <div class="energy-flow">
        <div class="flow-title">🔄 Flujo Energético en Tiempo Real</div>
        <div class="flow-container">
            <!-- Solar PV -->
            <div class="flow-node" id="pvNode">
                <div class="icon">☀️</div>
                <div class="label">Generación Solar</div>
                <div class="value" id="pvPower">0</div>
                <div class="unit">W</div>
            </div>

            <!-- Center (Balance & Arrows) -->
            <div class="flow-center">
                <div class="flow-arrow" id="pvToLoadArrow">
                    <span>Solar → Consumo</span>
                    <span class="arrow">→</span>
                    <span class="power" id="pvToLoad">0 W</span>
                </div>
                <div class="flow-arrow charging" id="batteryArrow">
                    <span>Batería</span>
                    <span class="arrow" id="batteryDir">↔</span>
                    <span class="power" id="batteryFlow">0 W</span>
                </div>
                <div class="flow-arrow" id="gridArrow">
                    <span>Red</span>
                    <span class="arrow" id="gridDir">↔</span>
                    <span class="power" id="gridFlow">0 W</span>
                </div>
                <div class="balance-box">
                    <div class="label">Balance Energético</div>
                    <div class="value" id="balanceValue">0 W</div>
                </div>
            </div>

            <!-- Load -->
            <div class="flow-node warning" id="loadNode">
                <div class="icon">🏭</div>
                <div class="label">Consumo Planta</div>
                <div class="value" id="loadPower">0</div>
                <div class="unit">W</div>
            </div>
        </div>
    </div>

    <!-- CONFIGURACIÓN -->
    <div class="grid2">
        <div class="card">
            <div class="card-title">☀️ Generación Solar</div>
            <form id="solarForm">
                <div class="form-group">
                    <label>Latitud</label>
                    <input type="number" step="0.01" name="latitude" value="40.4168">
                </div>
                <div class="form-group">
                    <label>Longitud</label>
                    <input type="number" step="0.01" name="longitude" value="-3.7038">
                </div>
                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" name="date" value="2026-06-21">
                </div>
                <div class="form-group">
                    <label>Potencia Pico (kWp)</label>
                    <input type="number" step="0.1" name="kwp" value="6.0">
                </div>
                <div class="form-group">
                    <label>Inclinación (°)</label>
                    <input type="number" step="1" name="tilt" value="35">
                </div>
                <div class="form-group">
                    <label>Azimut (°)</label>
                    <input type="number" step="1" name="azimuth" value="180">
                </div>
                <button type="submit" class="btn btn-primary">Generar Perfil Solar</button>
            </form>
            <div id="solarStats" class="stats-row" style="display: none;"></div>
        </div>

        <div class="card">
            <div class="card-title">🏭 Perfil de Consumo</div>
            <form id="loadForm">
                <div class="form-group">
                    <label>Tipo de Industria</label>
                    <select name="profile_type">
                        <option value="industrial">Industrial 24h</option>
                        <option value="industrial_shifts">Industrial 2 Turnos</option>
                        <option value="commercial">Comercial</option>
                        <option value="residential">Residencial</option>
                        <option value="datacenter">Data Center</option>
                        <option value="retail">Retail</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" name="date" value="2026-06-21">
                </div>
                <div class="form-group">
                    <label>Consumo Pico (kW)</label>
                    <input type="number" step="0.1" name="peak_kw" value="50.0">
                </div>
                <div class="form-group">
                    <label>Semilla (opcional, para reproducibilidad)</label>
                    <input type="number" name="seed" placeholder="Dejar vacío para aleatorio">
                </div>
                <button type="submit" class="btn btn-primary">Generar Perfil Consumo</button>
            </form>
            <div id="loadStats" class="stats-row" style="display: none;"></div>
        </div>
    </div>

    <!-- CONTROL SIMULADOR -->
    <div class="card">
        <div class="card-title">🎮 Control del Simulador</div>
        <div class="grid3">
            <div>
                <label style="color: #cbd5e1; font-size: 0.85rem; display: block; margin-bottom: 5px;">Capacidad Batería (kWh)</label>
                <input type="number" step="0.1" id="capacityKwh" value="10.0" style="width: 100%; padding: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #f1f5f9;">
            </div>
            <div>
                <label style="color: #cbd5e1; font-size: 0.85rem; display: block; margin-bottom: 5px;">SoC Inicial (%) <span style="color: #94a3b8; font-weight: normal;">*</span></label>
                <input type="number" step="1" id="initialSoc" value="50" style="width: 100%; padding: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #f1f5f9;">
            </div>
            <div>
                <label style="color: #cbd5e1; font-size: 0.85rem; display: block; margin-bottom: 5px;">Potencia Batería (kW)</label>
                <input type="number" step="0.1" id="powerKw" value="5.0" style="width: 100%; padding: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #f1f5f9;">
            </div>
        </div>
        <div class="grid3" style="margin-top: 10px;">
            <div>
                <label style="color: #cbd5e1; font-size: 0.85rem; display: block; margin-bottom: 5px;">Potencia Inversor (kW)</label>
                <input type="number" step="0.1" id="inverterKw" value="10.0" style="width: 100%; padding: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #f1f5f9;">
            </div>
            <div>
                <label style="color: #cbd5e1; font-size: 0.85rem; display: block; margin-bottom: 5px;">Aceleración Tiempo (x)</label>
                <input type="number" step="1" id="timeAccel" value="60" style="width: 100%; padding: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #f1f5f9;">
            </div>
            <div></div>
        </div>
        <div style="margin-top: 12px; padding: 10px; background: rgba(59,130,246,0.1); border-radius: 6px; font-size: 0.8rem; color: #94a3b8;">
            <strong style="color: #3b82f6;">*</strong> Con perfiles activos, el SoC se calcula automáticamente desde medianoche hasta la hora actual del sistema
        </div>
        <div style="display: flex; gap: 10px; margin-top: 15px;">
            <button class="btn btn-success" id="startSimBtn" style="flex: 2;">▶ Iniciar Simulador</button>
            <button class="btn btn-danger" id="stopSimBtn" style="flex: 1;">⏹ Detener</button>
        </div>
        <div id="simAlert" style="margin-top: 10px;"></div>
    </div>

    <!-- GRÁFICAS -->
    <div class="grid2">
        <div class="card">
            <div class="card-title">📈 Perfil Solar del Día</div>
            <div class="chart-container">
                <canvas id="solarChart"></canvas>
            </div>
        </div>
        <div class="card">
            <div class="card-title">📊 Perfil de Consumo del Día</div>
            <div class="chart-container">
                <canvas id="loadChart"></canvas>
            </div>
        </div>
    </div>

    <div class="grid2">
        <div class="card">
            <div class="card-title">🔋 Estado Batería</div>
            <div class="chart-container">
                <canvas id="batteryChart"></canvas>
            </div>
        </div>
        <div class="card">
            <div class="card-title">⚡ Potencias en Tiempo Real</div>
            <div class="chart-container">
                <canvas id="powerChart"></canvas>
            </div>
        </div>
    </div>

    <!-- REGISTROS MODBUS (AL FINAL) -->
    <div class="card">
        <div class="card-title">📝 Registros Modbus (últimos 50)</div>
        <div class="log-panel" id="modbusLog"></div>
    </div>
</div>

<script>
// Charts
let solarChart, loadChart, batteryChart, powerChart;
let solarProfileData = [];
let loadProfileData = [];

// WebSocket
let ws = null;

// Initialize charts
function initCharts() {
    const chartOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94a3b8' } },
            y: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94a3b8' } }
        }
    };

    solarChart = new Chart(document.getElementById('solarChart'), {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Solar (W)', data: [], borderColor: '#fbbf24', fill: true, backgroundColor: 'rgba(251,191,36,0.1)' }] },
        options: chartOptions
    });

    loadChart = new Chart(document.getElementById('loadChart'), {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Consumo (W)', data: [], borderColor: '#f97316', fill: true, backgroundColor: 'rgba(249,115,22,0.1)' }] },
        options: chartOptions
    });

    batteryChart = new Chart(document.getElementById('batteryChart'), {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { label: 'SoC (%)', data: [], borderColor: '#3b82f6', yAxisID: 'y' },
                { label: 'Potencia (W)', data: [], borderColor: '#22c55e', yAxisID: 'y1' }
            ]
        },
        options: {
            ...chartOptions,
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94a3b8' } },
                y: { type: 'linear', position: 'left', grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94a3b8' } },
                y1: { type: 'linear', position: 'right', grid: { display: false }, ticks: { color: '#94a3b8' } }
            }
        }
    });

    powerChart = new Chart(document.getElementById('powerChart'), {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { label: 'Solar', data: [], borderColor: '#fbbf24' },
                { label: 'Consumo', data: [], borderColor: '#f97316' },
                { label: 'Batería', data: [], borderColor: '#3b82f6' }
            ]
        },
        options: { ...chartOptions, plugins: { legend: { display: true, labels: { color: '#94a3b8' } } } }
    });
}

// Solar form
document.getElementById('solarForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);

    try {
        const res = await fetch('/api/solar/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.status === 'ok') {
            solarProfileData = result.profile_data;
            updateSolarChart();
            document.getElementById('solarStats').style.display = 'flex';
            document.getElementById('solarStats').innerHTML = `
                <div class="stat-mini"><div class="label">Pico</div><div class="value">${(result.stats.peak_power_w/1000).toFixed(2)} kW</div></div>
                <div class="stat-mini"><div class="label">Energía</div><div class="value">${result.stats.daily_energy_kwh.toFixed(2)} kWh</div></div>
                <div class="stat-mini"><div class="label">Amanecer</div><div class="value">${result.stats.sunrise}</div></div>
                <div class="stat-mini"><div class="label">Atardecer</div><div class="value">${result.stats.sunset}</div></div>
            `;
            alert('✓ Perfil solar generado correctamente');
        }
    } catch (err) {
        alert('Error generando perfil solar: ' + err.message);
    }
});

// Load form
document.getElementById('loadForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);

    try {
        const res = await fetch('/api/load/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.status === 'ok') {
            loadProfileData = result.profile_data;
            updateLoadChart();
            document.getElementById('loadStats').style.display = 'flex';
            document.getElementById('loadStats').innerHTML = `
                <div class="stat-mini"><div class="label">Pico</div><div class="value">${(result.stats.peak_power_w/1000).toFixed(2)} kW</div></div>
                <div class="stat-mini"><div class="label">Media</div><div class="value">${(result.stats.avg_power_w/1000).toFixed(2)} kW</div></div>
                <div class="stat-mini"><div class="label">Energía</div><div class="value">${result.stats.daily_energy_kwh.toFixed(2)} kWh</div></div>
                <div class="stat-mini"><div class="label">Factor</div><div class="value">${(result.stats.load_factor*100).toFixed(0)}%</div></div>
            `;
            alert('✓ Perfil de consumo generado correctamente');
        }
    } catch (err) {
        alert('Error generando perfil: ' + err.message);
    }
});

function updateSolarChart() {
    const labels = solarProfileData.map(d => new Date(d.timestamp).toLocaleTimeString('es', {hour:'2-digit', minute:'2-digit'}));
    const data = solarProfileData.map(d => d.power_w);
    solarChart.data.labels = labels;
    solarChart.data.datasets[0].data = data;
    solarChart.update();
}

function updateLoadChart() {
    const labels = loadProfileData.map(d => new Date(d.timestamp).toLocaleTimeString('es', {hour:'2-digit', minute:'2-digit'}));
    const data = loadProfileData.map(d => d.power_w);
    loadChart.data.labels = labels;
    loadChart.data.datasets[0].data = data;
    loadChart.update();
}

// Simulator controls
document.getElementById('startSimBtn').addEventListener('click', async () => {
    const capacity = parseFloat(document.getElementById('capacityKwh').value);
    const soc = parseFloat(document.getElementById('initialSoc').value);
    const power = parseFloat(document.getElementById('powerKw').value);
    const inverter = parseFloat(document.getElementById('inverterKw').value);
    const timeAccel = parseFloat(document.getElementById('timeAccel').value);

    try {
        const res = await fetch('/api/simulator/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                capacity_kwh: capacity,
                initial_soc: soc,
                power_kw: power,
                inverter_kw: inverter,
                time_accel: timeAccel
            })
        });
        const result = await res.json();

        if (result.status === 'ok') {
            document.getElementById('simAlert').innerHTML = '<div class="alert alert-success">✓ Simulador iniciado</div>';
            document.getElementById('simStatus').className = 'status-badge running';
            document.getElementById('simStatus').textContent = 'RUNNING';
            // No recargar la página para mantener los perfiles generados
        } else {
            document.getElementById('simAlert').innerHTML = `<div class="alert alert-error">Error: ${result.message}</div>`;
        }
    } catch (err) {
        document.getElementById('simAlert').innerHTML = `<div class="alert alert-error">Error: ${err.message}</div>`;
    }
});

document.getElementById('stopSimBtn').addEventListener('click', async () => {
    try {
        const res = await fetch('/api/simulator/stop', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await res.json();

        if (result.status === 'ok') {
            document.getElementById('simAlert').innerHTML = '<div class="alert alert-success">✓ Simulador detenido</div>';
            document.getElementById('simStatus').className = 'status-badge stopped';
            document.getElementById('simStatus').textContent = 'STOPPED';
        }
    } catch (err) {
        document.getElementById('simAlert').innerHTML = `<div class="alert alert-error">Error: ${err.message}</div>`;
    }
});

// WebSocket connection
function connectWebSocket() {
    ws = new WebSocket(`ws://${window.location.host}/ws`);

    ws.onmessage = (event) => {
        const data = JSON.parse(event.data);
        updateDashboard(data);
    };

    ws.onclose = () => {
        console.log('WebSocket closed, reconnecting...');
        setTimeout(connectWebSocket, 3000);
    };
}

function updateDashboard(data) {
    // Time
    if (data.simulated_time) {
        const dt = new Date(data.simulated_time * 1000);
        document.getElementById('simTime').textContent = dt.toLocaleTimeString('es');
    }

    // Energy flow (usar !== undefined para permitir valor 0)
    const pv = data.pv_power_w !== undefined ? data.pv_power_w : 0;
    const load = data.load_power_w !== undefined ? data.load_power_w : 0;
    const bat = data.battery_power_w !== undefined ? data.battery_power_w : 0;
    const balance = pv - load;

    document.getElementById('pvPower').textContent = Math.round(pv);
    document.getElementById('loadPower').textContent = Math.round(load);
    document.getElementById('pvToLoad').textContent = Math.round(Math.min(pv, load)) + ' W';

    // Battery
    document.getElementById('batteryFlow').textContent = Math.abs(Math.round(bat)) + ' W';
    const batteryArrow = document.getElementById('batteryArrow');
    const batteryDir = document.getElementById('batteryDir');
    if (bat > 100) {
        batteryArrow.className = 'flow-arrow charging';
        batteryDir.textContent = '⬆';
        batteryDir.parentElement.firstElementChild.textContent = 'Batería (Cargando)';
    } else if (bat < -100) {
        batteryArrow.className = 'flow-arrow import';
        batteryDir.textContent = '⬇';
        batteryDir.parentElement.firstElementChild.textContent = 'Batería (Descargando)';
    } else {
        batteryArrow.className = 'flow-arrow';
        batteryDir.textContent = '↔';
    }

    // Grid (calculated)
    const grid = balance - bat;
    document.getElementById('gridFlow').textContent = Math.abs(Math.round(grid)) + ' W';
    const gridArrow = document.getElementById('gridArrow');
    const gridDir = document.getElementById('gridDir');
    if (grid > 100) {
        gridArrow.className = 'flow-arrow export';
        gridDir.textContent = '⬆';
        gridDir.parentElement.firstElementChild.textContent = 'Red (Exportando)';
    } else if (grid < -100) {
        gridArrow.className = 'flow-arrow import';
        gridDir.textContent = '⬇';
        gridDir.parentElement.firstElementChild.textContent = 'Red (Importando)';
    } else {
        gridArrow.className = 'flow-arrow';
        gridDir.textContent = '↔';
    }

    // Balance
    const balanceEl = document.getElementById('balanceValue');
    balanceEl.textContent = (balance >= 0 ? '+' : '') + Math.round(balance) + ' W';
    balanceEl.className = 'value ' + (balance > 0 ? 'surplus' : 'deficit');

    // Update charts
    const now = new Date().toLocaleTimeString();
    if (batteryChart.data.labels.length > 60) {
        batteryChart.data.labels.shift();
        batteryChart.data.datasets[0].data.shift();
        batteryChart.data.datasets[1].data.shift();
    }
    batteryChart.data.labels.push(now);
    batteryChart.data.datasets[0].data.push(data.soc !== undefined ? data.soc : 0);
    batteryChart.data.datasets[1].data.push(bat);
    batteryChart.update('none');

    if (powerChart.data.labels.length > 60) {
        powerChart.data.labels.shift();
        powerChart.data.datasets.forEach(ds => ds.data.shift());
    }
    powerChart.data.labels.push(now);
    powerChart.data.datasets[0].data.push(pv);
    powerChart.data.datasets[1].data.push(load);
    powerChart.data.datasets[2].data.push(bat);
    powerChart.update('none');

    // Modbus log
    const soc = data.soc !== undefined ? data.soc : 0;
    addModbusLog(`${new Date().toLocaleTimeString()} - PV:${Math.round(pv)}W Load:${Math.round(load)}W Bat:${Math.round(bat)}W SoC:${soc.toFixed(1)}%`);
}

function addModbusLog(text) {
    const logPanel = document.getElementById('modbusLog');
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.textContent = text;
    logPanel.insertBefore(entry, logPanel.firstChild);

    // Keep last 50 entries
    while (logPanel.children.length > 50) {
        logPanel.removeChild(logPanel.lastChild);
    }
}

// Initialize
initCharts();
connectWebSocket();
</script>
</body>
</html>
